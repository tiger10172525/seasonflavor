# LINE Pay 商家設定（到 LINE Pay My Merchant 申請）
LINE_PAY_CHANNEL_ID=你的_Channel_ID
LINE_PAY_CHANNEL_SECRET=你的_Channel_Secret

# 環境切換：sandbox（沙箱測試）或 production（正式上線）
LINE_PAY_ENV=sandbox

# 伺服器設定
PORT=3000

# 本站公開網址（LINE Pay 回呼需要可外部存取的 URL）
# 本機測試請用 ngrok：ngrok http 3000，然後填入 ngrok 提供的 https:// 網址
BASE_URL=http://localhost:3000
